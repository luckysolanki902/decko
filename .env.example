# Copy to .env.local and fill in. Never commit a real environment file.
#
#   cp .env.example .env.local

# ── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string. A free Atlas cluster is enough.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Session signing key. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# Database name within the cluster. Defaults to "decko".
# Set this to run a staging copy against the same connection string.
# MONGODB_DB=decko

# Canonical site URL, used for metadata, Open Graph and the sitemap.
# Defaults to https://decko.vercel.app
# NEXT_PUBLIC_SITE_URL=https://decko.vercel.app

# Repository link shown in the header and footer.
# NEXT_PUBLIC_GITHUB_URL=https://github.com/luckysolanki902/decko

# Shared secret for the optional MCP endpoint at /api/mcp.
# Leave unset unless you are using it; the default is development-only.
# MCP_API_SECRET=

# ── Not used ────────────────────────────────────────────────────────────────
#
# There is deliberately no model API key here. Course content and revision sets
# are written by hand, not generated at runtime, so the application makes no
# calls to any AI provider and costs nothing to run beyond hosting and the
# database.
